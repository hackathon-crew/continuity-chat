# 数据库。账号、密码和库名分开填写，程序会拼成 PostgreSQL 连接串。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DATABASE=chatbot
# 连接池。pool_size 是常驻连接数，max_overflow 是突发时允许额外打开的连接数。
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10
# 等待空闲连接的秒数。超过后本次请求失败。
POSTGRES_POOL_TIMEOUT=30
# 连接回收秒数，避免数据库侧已断开的旧连接继续被使用。
POSTGRES_POOL_RECYCLE=1800
# 取连接前先探测是否可用。
POSTGRES_POOL_PRE_PING=true
# 单条 SQL 的超时秒数。
POSTGRES_COMMAND_TIMEOUT=30

# 中转站。对话和标题生成走这里，按 token 计费。
# SUB2API_BASE_URL 填站点根地址，不要带 /v1beta。
# 模型请求使用登录时保存的用户 Key，不再读取全局调用 Key。
SUB2API_BASE_URL=https://unigate.top

# 授权码登录。客户端在中转站登记，密钥和加密钥只放在服务端。
# SUB2API_REDIRECT_URI 指向本站 GET /api/auth/callback。
# CREDENTIAL_KEY 是 32 字节密钥的 Base64。留空则不能登录。
SUB2API_CLIENT_ID=
SUB2API_CLIENT_SECRET=
SUB2API_REDIRECT_URI=
CREDENTIAL_KEY=

# 向量模型。长期记忆使用，费用由部署方承担，不进中转计费。
# EMBEDDING_URL 填 OpenAI 兼容地址，包含 /v1。
# EMBEDDING_MODEL 填该服务上的模型名。地址、Key、模型名都要填，否则不启用。
# EMBEDDING_DIMENSIONS 是向量维度，Qwen3-Embedding-8B 为 4096。留空时使用 4096。
EMBEDDING_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=4096

# 七牛云 Kodo。浏览器拿上传凭证后直接把文件传到七牛，文件不经过本服务。
# QINIU_DOMAIN 填空间绑定的访问域名，可以不写 https://。空间使用公开读。
# QINIU_CALLBACK_URL 是七牛上传成功后通知本服务的地址。留空则不启用回调。
# 密钥、空间、域名都要填，否则不能签发凭证。
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
QINIU_CALLBACK_URL=

# Mem0 的外接向量库。先单独启动 Qdrant，再填写地址。
# 本地没有鉴权时，QDRANT_API_KEY 留空。
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chat_memories

# 全站对话并发。限流器在当前进程的内存里排队，不使用 Redis。
# 同时进行的对话超过 CHAT_RATE_LIMIT_MAX_CONCURRENT 时按到达顺序等待。
# 等待超过 CHAT_RATE_LIMIT_MAX_WAIT_SECONDS 秒则拒绝。CHAT_RATE_LIMIT_ENABLED=false 时不限制。
CHAT_RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_MAX_CONCURRENT=50
CHAT_RATE_LIMIT_MAX_WAIT_SECONDS=20
CHAT_RATE_LIMIT_LEASE_SECONDS=600

# 雪花主键的机器号，范围 0 到 1023。单进程保持 0。
# 多个进程同时发号时，每个进程使用不同的号。
SNOWFLAKE_WORKER_ID=0
