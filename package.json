{
  "name": "continuity-chat",
  "version": "0.2.0",
  "description": "Unigate Chat — 接着聊，和 Uni 一起推进任务。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src server scripts --ignore-pattern 'src/everplain/**' --ignore-pattern 'src/inkpaw/**'",
    "format": "oxfmt --write ."
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three": "0.186.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/hast": "3.0.4",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.1.0",
    "typescript": "5.9.3",
    "vfile": "6.0.3",
    "vite": "7.1.12",
    "@types/node": "~20.9.2",
    "oxlint": "1.63.0",
    "oxfmt": "0.48.0"
  }
}
